<!DOCTYPE html>
<html>
  <head>
    <title>Payments</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <style>
      body { font-family: Arial, sans-serif; max-width: 640px; margin: 40px auto; }
      ul { padding-left: 20px; }
      li { margin-bottom: 6px; }
      form { margin-top: 24px; border-top: 1px solid #ddd; padding-top: 16px; }
      label { display: block; margin-top: 10px; font-weight: bold; }
      input[type=text], input[type=number] { width: 100%; padding: 6px; box-sizing: border-box; }
      button { margin-top: 16px; padding: 8px 16px; }
      .error { color: #b00020; }
      nav a { margin-right: 12px; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/inventory">Inventory</a>
      <a href="/orders">Orders</a>
      <a href="/payments">Payments</a>
    </nav>
    <h1>Payments</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <ul>
      <% payments.forEach(function(payment) { %>
        <li>order <%= payment.orderId %> - <%= payment.amount %> - <%= payment.status %></li>
      <% }); %>
    </ul>

    <form action="/payments" method="POST">
      <p><strong>Add Payment:</strong></p>
      <label for="orderId">Order ID</label>
      <input type="text" id="orderId" name="orderId" required>

      <label for="amount">Amount</label>
      <input type="number" id="amount" name="amount" step="0.01" min="0" required>

      <button type="submit">Submit</button>
    </form>
  </body>
</html>
